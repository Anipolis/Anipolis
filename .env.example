# Supabase
# https://supabase.com/dashboard/project/_/settings/api から取得
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 管理者メールアドレス（アニメカバー画像アップロード権限）
ADMIN_EMAIL=your-admin@example.com

# Discord（クローズドβのサーバー所属検証用 / Bot トークン方式）
# Discord Developer Portal で作成した Bot を対象サーバーに招待して取得
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_GUILD_ID=000000000000000000
# 任意: 特定ロール所持者のみ許可する場合に設定（未使用なら空でよい）
DISCORD_REQUIRED_ROLE_ID=

# クローズドβ: true にするとログイン画面で Discord ログインのみ表示する
PUBLIC_CLOSED_BETA=true
