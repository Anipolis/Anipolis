{
	"$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!**/package.json",
			"!supabase",
			"!.claude",
			"!**/.omc",
			// Biome 2.6 は Markdown / YAML / SVG も整形するが、このリポジトリでは対象外にする
			"!**/*.md",
			"!**/*.yml",
			"!**/*.yaml",
			"!**/*.svg"
		]
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"formatter": {
		"enabled": true,
		"indentWidth": 4,
		"lineWidth": 120
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noExplicitAny": "warn"
			},
			"style": {
				"noNonNullAssertion": "warn"
			},
			"a11y": {
				// Biome 2.6 で recommended に追加されたルール。既存 UI のマークアップ見直しは
				// 別途行うため、移行時点では warn にして CI を止めない。
				"noStaticElementInteractions": "warn",
				"useKeyWithClickEvents": "warn",
				"useSemanticElements": "warn",
				"noNoninteractiveTabindex": "warn",
				"useFocusableInteractive": "warn"
			},
			"complexity": {
				"useLiteralKeys": "off"
			}
		}
	},
	// scripts/ は tsc の対象外なので、未定義の変数参照だけはここで落とす（#335）
	"overrides": [
		{
			"includes": ["scripts/**"],
			"linter": {
				"rules": {
					"correctness": {
						"noUndeclaredVariables": "error"
					}
				}
			}
		}
	],
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"html": {
		"experimentalFullSupportEnabled": true,
		"formatter": {
			"enabled": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
