{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "anipolis",
	// SvelteKit のサーバー。adapter-cloudflare がここに _worker.js を書き出す
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-11-01",
	// 2026-08-04 以降の日付では既定で有効だが、サーバーが node:crypto を使うため明示する
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		// _worker.js から env.ASSETS で静的ファイルを読むため、名前は ASSETS から変えない
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	// $env/dynamic/public で実行時に読む公開値。ブラウザにも配る値なのでここに書いてよい。
	// wrangler deploy は設定ファイルに無い平文の変数を消すので、ダッシュボードではなくここを正本にする
	"vars": {
		"PUBLIC_SUPABASE_URL": "https://jxrfsbhluooyrkrooger.supabase.co",
		"PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_ZEfawievEHmoSkrn-IMHwg_kq9rq8Qd",
		"PUBLIC_CLOSED_BETA": "true",
		"PUBLIC_PASSKEY_ENABLED": "true"
	},
	// ダッシュボードで足した変数（ADMIN_MFA_REQUIRED などの一時的なスイッチ）も deploy で消さない
	"keep_vars": true
}
