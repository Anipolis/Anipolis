{
	"name": "anipolis",
	"version": "0.0.1",
	"license": "MIT",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.8.1",
	"engines": {
		"node": ">=22.14.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"deploy": "vite build && wrangler pages deploy .svelte-kit/cloudflare --project-name anipolis --commit-dirty=true",
		"preview": "vite preview",
		"prepare": "simple-git-hooks",
		"check:biome": "biome check .",
		"check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:types": "svelte-kit sync && tsc --noEmit",
		"check:anime-view": "node --experimental-strip-types scripts/check-anime-view-types.ts",
		"check": "pnpm check:biome && pnpm check:svelte && pnpm check:types && pnpm check:anime-view",
		"test:unit": "vitest --run --coverage",
		"test": "pnpm test:unit",
		"supabase:version": "supabase --version",
		"supabase:migrations": "supabase migration list",
		"supabase:types": "node scripts/generate-supabase-types.mjs",
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"format": "biome format --write .",
		"import:jikan": "node --env-file-if-exists=.env --experimental-strip-types scripts/import-jikan-season.ts",
		"import:jikan-covers": "node --env-file-if-exists=.env --experimental-strip-types scripts/import-jikan-covers.ts",
		"import:mal": "node --env-file-if-exists=.env --experimental-strip-types scripts/import-mal-season.ts",
		"import:anime-offline": "node --env-file-if-exists=.env --experimental-strip-types scripts/import-anime-offline-database.ts",
		"import:wikidata-titles": "node --env-file-if-exists=.env --experimental-strip-types scripts/import-wikidata-anime-titles.ts",
		"import:wikidata-studios": "node --env-file-if-exists=.env --experimental-strip-types scripts/import-wikidata-studio-names.ts",
		"import:syobocal": "node --env-file-if-exists=.env --experimental-strip-types scripts/import-syobocal.ts",
		"import:annict": "node --env-file-if-exists=.env --experimental-strip-types scripts/import-annict.ts",
		"sync:syobocal-programs": "node --env-file-if-exists=.env --experimental-strip-types scripts/import-syobocal.ts --sync-programs",
		"audit:episode-numbers": "node --env-file-if-exists=.env --experimental-strip-types scripts/audit-episode-numbers.ts",
		"resolve:anime-catalog": "node --env-file-if-exists=.env --experimental-strip-types scripts/resolve-anime-catalog.ts",
		"export:anime-catalog": "node --env-file-if-exists=.env --experimental-strip-types scripts/export-anime-catalog.ts",
		"generate:cover-thumbnails": "node --env-file-if-exists=.env --experimental-strip-types scripts/generate-cover-thumbnails.ts",
		"enrich:jikan-links": "node --env-file-if-exists=.env --experimental-strip-types scripts/enrich-jikan-links.ts",
		"collect:copyright": "node --env-file-if-exists=.env --experimental-strip-types scripts/collect-copyright-notices.ts",
		"collect:official-x": "node --env-file-if-exists=.env --experimental-strip-types scripts/collect-official-x.ts",
		"collect:wayback": "node --env-file-if-exists=.env --experimental-strip-types scripts/collect-wayback.ts"
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm check:biome"
	},
	"dependencies": {
		"@fontsource/zen-maru-gothic": "^5.3.0",
		"@supabase/ssr": "^0.6.1",
		"@supabase/supabase-js": "^2.105.4",
		"fast-xml-parser": "^5.10.1",
		"marked": "^18.0.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@iconify-json/lucide": "^1.2.108",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.60.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tsconfig/strictest": "^2.0.8",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^25.8.0",
		"@unocss/preset-icons": "^66.6.8",
		"@unocss/preset-wind3": "^66.6.8",
		"@vitest/coverage-v8": "^4.1.6",
		"happy-dom": "^20.9.0",
		"sharp": "^0.34.5",
		"simple-git-hooks": "^2.13.1",
		"supabase": "^2.107.0",
		"svelte": "^5.55.7",
		"svelte-check": "^4.4.8",
		"typescript": "^5.9.3",
		"unocss": "^66.6.8",
		"vite": "^7.3.3",
		"vitest": "^4.1.6"
	}
}
