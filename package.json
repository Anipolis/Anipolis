{
	"name": "anipolis",
	"version": "0.0.1",
	"license": "MIT",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.33.2",
	"engines": {
		"node": ">=22.14.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "simple-git-hooks",
		"check:biome": "biome check --write",
		"check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:types": "tsc --noEmit",
		"check": "pnpm check:biome && pnpm check:svelte && pnpm check:types",
		"test:unit": "vitest --run --coverage",
		"test": "pnpm test:unit",
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"format": "biome format --write .",
		"import:jikan": "node --env-file-if-exists=.env --experimental-strip-types scripts/import-jikan-season.ts"
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm check:biome"
	},
	"dependencies": {
		"@supabase/ssr": "^0.6.1",
		"@supabase/supabase-js": "^2.105.4"
	},
	"devDependencies": {
		"@iconify-json/lucide": "^1.2.108",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.60.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tsconfig/strictest": "^2.0.8",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^25.8.0",
		"@unocss/preset-icons": "^66.6.8",
		"@unocss/preset-wind3": "^66.6.8",
		"@vitest/coverage-v8": "^4.1.6",
		"happy-dom": "^20.9.0",
		"simple-git-hooks": "^2.13.1",
		"svelte": "^5.55.7",
		"svelte-check": "^4.4.8",
		"typescript": "^5.9.3",
		"unocss": "^66.6.8",
		"vite": "^7.3.3",
		"vitest": "^4.1.6"
	}
}
